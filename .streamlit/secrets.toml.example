# Copy to secrets.toml (gitignored) and fill in.
#
# Both are also read from the environment, so exporting them works without this
# file at all. On Streamlit Community Cloud, paste the same keys into the app's
# Secrets box instead.

# REQUIRED. The app refuses to start without it — see auth.py for why failing
# closed is the point rather than an inconvenience. Generate one with:
#   openssl rand -base64 24
DASHBOARD_PASSWORD = "..."

# Supabase: use the SESSION pooler on 5432, not the transaction pooler on 6543,
# and URL-encode the password (@ becomes %40).
#
# Give this a SELECT-only role rather than `postgres`. The dashboard sets its
# session read-only on connect, but that stops the dashboard writing — it does
# not stop whoever obtains the credential.
DATABASE_URL = "postgresql://gurt_readonly:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional. Defaults to the vendored Supabase root in certs/, which is what
# remote connections are verified against. Relative paths resolve from the
# repository root.
# PGSSLROOTCERT = "certs/supabase-prod-ca-2021.crt"
